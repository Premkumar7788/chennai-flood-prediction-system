Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"      # Ubuntu 22.04 LTS
  config.vm.hostname = "sprint10-vm"

  # Networking
  config.vm.network "private_network", ip: "192.168.56.10"
  config.vm.network "forwarded_port", guest: 5601, host: 5601   # Kibana
  config.vm.network "forwarded_port", guest: 9200, host: 9200   # Elasticsearch
  config.vm.network "forwarded_port", guest: 8080, host: 8081   # Application

  # Resources (ELK needs at least 4 GB)
  config.vm.provider "virtualbox" do |vb|
    vb.name = "sprint10-elk-vm"
    vb.cpus = 2
    vb.memory = 4096
  end

  # Provisioning: Docker + Elasticsearch kernel setting
  config.vm.provision "shell", inline: <<-SHELL
    apt-get update -y
    curl -fsSL https://get.docker.com | sh
    usermod -aG docker vagrant
    sysctl -w vm.max_map_count=262144
    echo "vm.max_map_count=262144" >> /etc/sysctl.conf
  SHELL
end
